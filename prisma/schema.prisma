generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  mobile        String?         @unique
  passwordHash  String?
  avatarUrl     String?         @db.Text
  role          UserRole        @default(CUSTOMER)
  status        EntityStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  addresses     Address[]
  cart          Cart?
  favorites     Favorite[]
  orders        Order[]
  couponUsages  CouponUsage[]
  tickets       SupportTicket[]
  refreshTokens RefreshToken[]
  searches      SearchHistory[]
  ratings       ProductRating[]

  @@map("users")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  mobile    String
  house     String
  street    String?
  landmark  String?
  area      String
  city      String
  district  String?
  state     String
  pin       String
  type      String   @default("Home")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  image     String?      @db.Text
  color     String?
  position  Int          @default(0)
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  parentId  String?
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String         @id
  name              String
  slug              String         @unique
  description       String         @db.Text
  unit              String
  sku               String         @unique
  mrp               Decimal        @db.Decimal(10, 2)
  price             Decimal        @db.Decimal(10, 2)
  stock             Int            @default(0)
  lowStockThreshold Int            @default(10)
  status            EntityStatus   @default(ACTIVE)
  featured          Boolean        @default(false)
  bestSeller        Boolean        @default(false)
  categoryId        String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  variantGroupId    String?
  ratings           ProductRating[]
  category          Category       @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  cartItems         CartItem[]
  favorites         Favorite[]
  orderItems        OrderItem[]

  @@index([categoryId, status])
  @@index([name])
  @@index([variantGroupId])
  @@unique([variantGroupId, unit])
  @@map("products")
}

model ProductRating {
  id        String   @id @default(cuid())
  userId    String
  productId String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
  @@map("product_ratings")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.Text
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Coupon {
  id              String        @id @default(cuid())
  code            String        @unique
  type            DiscountType
  discount        Decimal       @db.Decimal(10, 2)
  minimumOrder    Decimal       @db.Decimal(10, 2)
  maximumDiscount Decimal?      @db.Decimal(10, 2)
  usageLimit      Int?
  perUserLimit    Int           @default(1)
  usageCount      Int           @default(0)
  startsAt        DateTime
  expiresAt       DateTime
  status          EntityStatus  @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  usages          CouponUsage[]
  orders          Order[]

  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String   @unique
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_usages")
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  userId              String
  couponId            String?
  status              OrderStatus          @default(NEW)
  paymentMethod       PaymentMethod        @default(COD)
  paymentStatus       PaymentStatus        @default(PENDING)
  itemTotal           Decimal              @db.Decimal(10, 2)
  productDiscount     Decimal              @db.Decimal(10, 2)
  couponDiscount      Decimal              @db.Decimal(10, 2)
  deliveryFee         Decimal              @db.Decimal(10, 2)
  handlingFee         Decimal              @db.Decimal(10, 2)
  grandTotal          Decimal              @db.Decimal(10, 2)
  addressSnapshot     Json
  deliveryInstruction String?
  deliveryType        String               @default("INSTANT")
  deliveryDate        String?
  deliverySlot        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id])
  coupon              Coupon?              @relation(fields: [couponId], references: [id])
  items               OrderItem[]
  history             OrderStatusHistory[]
  payment             Payment?
  couponUsage         CouponUsage?

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  sku       String
  unit      String
  image     String? @db.Text
  mrp       Decimal @db.Decimal(10, 2)
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  method    PaymentMethod
  status    PaymentStatus
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  order     Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Banner {
  id          String       @id @default(cuid())
  kicker      String?
  heading     String
  subtitle    String?
  image       String?      @db.Text
  ctaText     String?
  destination String?
  position    Int          @default(0)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("banners")
}

model DeliveryArea {
  id                    String       @id @default(cuid())
  name                  String
  pincodes              Json
  radiusKm              Decimal?     @db.Decimal(6, 2)
  minimumOrder          Decimal      @db.Decimal(10, 2)
  deliveryFee           Decimal      @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal      @db.Decimal(10, 2)
  estimatedMinutes      Int
  status                EntityStatus @default(ACTIVE)

  @@map("delivery_areas")
}

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  userId       String
  orderId      String?
  issueType    String
  subject      String
  description  String          @db.Text
  status       TicketStatus    @default(OPEN)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id])
  messages     TicketMessage[]

  @@index([userId, status])
  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String?
  isAdmin   Boolean       @default(false)
  message   String        @db.Text
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model StoreSetting {
  id                    Int      @id @default(1)
  storeName             String
  logo                  String?  @db.Text
  contactNumber         String
  email                 String
  address               String   @db.Text
  openingTime           String
  closingTime           String
  currency              String   @default("INR")
  minimumOrder          Decimal  @db.Decimal(10, 2)
  deliveryFee           Decimal  @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal  @db.Decimal(10, 2)
  estimatedDelivery     String
  notifications         Json
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}

model OtpVerification {
  id                  String    @id @default(cuid())
  identifier          String
  purpose             String    @default("signup")
  codeHash            String
  pendingName         String?
  pendingMobile       String?
  pendingPasswordHash String?
  expiresAt           DateTime
  attempts            Int       @default(0)
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([identifier, createdAt])
  @@map("otp_verifications")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("search_history")
}
