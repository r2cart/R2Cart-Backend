generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
  SUPER_ADMIN
  DELIVERY_PERSON
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERY_PROOF_PENDING
  DELIVERED
  DELIVERY_FAILED
}

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  mobile        String?         @unique
  passwordHash  String?
  avatarUrl     String?         @db.Text
  role          UserRole        @default(CUSTOMER)
  status        EntityStatus    @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  addresses     Address[]
  cart          Cart?
  favorites     Favorite[]
  orders        Order[]
  couponUsages  CouponUsage[]
  tickets       SupportTicket[]
  refreshTokens RefreshToken[]
  searches      SearchHistory[]
  ratings       ProductRating[]
  pushSubscriptions PushSubscription[]
  deviceTokens  DeviceToken[]
  staffRole     String?
  permissions   Json?
  isStaffActive Boolean         @default(true)
  dutyStatus    String?         @default("OFF_DUTY")
  assignedVillageIds Json?
  assignedCategoryIds Json?
  vehicleType   String?
  vehicleNumber String?
  deliveryStaffId String?       @unique
  currentLatitude  Decimal?     @db.Decimal(10, 8)
  currentLongitude Decimal?     @db.Decimal(11, 8)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  auditLogs     AuditLog[]

  assignedDeliveries DeliveryAssignment[] @relation("AssignedDeliveries")
  createdAssignments DeliveryAssignment[] @relation("AssignmentsCreated")
  deliveryProofs     DeliveryProof[]
  verifiedProofs     DeliveryProof[]      @relation("VerifiedProofs")
  deliveryStatusLogs DeliveryStatusLog[]
  codCollections     CodCollection[]
  codSettlements     CodSettlement[]      @relation("SettledCollections")
  adminSettlements   CodSettlement[]      @relation("AdminSettlements")
  deliveryChatMessages DeliveryChatMessage[]
  recordedPurchases  Purchase[]           @relation("PurchasesReceived")
  recordedSupplierPayments SupplierPayment[] @relation("SupplierPaymentsCreated")
  recordedExpenses   Expense[]            @relation("ExpensesCreated")

  @@map("users")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  mobile    String
  house     String
  street    String?
  landmark  String?
  area      String
  city      String
  district  String?
  state     String
  pin       String
  type      String   @default("Home")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model Category {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  image     String?      @db.Text
  color     String?
  position  Int          @default(0)
  status    EntityStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  parentId  String?
  parent    Category?    @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[]   @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String         @id
  name              String
  slug              String         @unique
  description       String         @db.Text
  unit              String
  sku               String         @unique
  mrp               Decimal        @db.Decimal(10, 2)
  price             Decimal        @db.Decimal(10, 2)
  costPrice         Decimal        @default(0) @db.Decimal(10, 2)
  stock             Int            @default(0)
  lowStockThreshold Int            @default(10)
  status            EntityStatus   @default(ACTIVE)
  featured          Boolean        @default(false)
  bestSeller        Boolean        @default(false)
  categoryId        String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?
  variantGroupId    String?
  hasExpiry         Boolean        @default(false)
  expiryDate        DateTime?
  batchNumber       String?
  deliveryScope     String         @default("LOCAL") // "LOCAL" | "PAN_INDIA" | "CUSTOM"
  deliveryLocations Json?
  shippingFee       Decimal?       @default(0) @db.Decimal(10, 2)
  ratings           ProductRating[]
  category          Category       @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  cartItems         CartItem[]
  favorites         Favorite[]
  orderItems        OrderItem[]
  inventoryLogs     InventoryLog[]
  purchaseItems     PurchaseItem[]
  fifoBatches       FifoCostBatch[]
  fifoAllocations   OrderFifoAllocation[]

  @@index([categoryId, status])
  @@index([name])
  @@index([variantGroupId])
  @@unique([variantGroupId, unit])
  @@map("products")
}

model ProductRating {
  id        String   @id @default(cuid())
  userId    String
  productId String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
  @@map("product_ratings")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String  @db.Text
  alt       String?
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("favorites")
}

model Coupon {
  id              String        @id @default(cuid())
  code            String        @unique
  type            DiscountType
  discount        Decimal       @db.Decimal(10, 2)
  minimumOrder    Decimal       @db.Decimal(10, 2)
  maximumDiscount Decimal?      @db.Decimal(10, 2)
  usageLimit      Int?
  perUserLimit    Int           @default(1)
  usageCount      Int           @default(0)
  isFirstOrderOnly Boolean      @default(false)
  targetUserIds   Json?
  campaignName    String?
  description     String?
  startsAt        DateTime
  expiresAt       DateTime
  status          EntityStatus  @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  usages          CouponUsage[]
  orders          Order[]

  @@map("coupons")
}

model CouponUsage {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  orderId  String   @unique
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])

  @@index([couponId, userId])
  @@map("coupon_usages")
}

model Order {
  id                  String               @id @default(cuid())
  orderNumber         String               @unique
  userId              String
  couponId            String?
  status              OrderStatus          @default(NEW)
  paymentMethod       PaymentMethod        @default(COD)
  paymentStatus       PaymentStatus        @default(PENDING)
  itemTotal           Decimal              @db.Decimal(10, 2)
  productDiscount     Decimal              @db.Decimal(10, 2)
  couponDiscount      Decimal              @db.Decimal(10, 2)
  deliveryFee         Decimal              @db.Decimal(10, 2)
  handlingFee         Decimal              @db.Decimal(10, 2)
  grandTotal          Decimal              @db.Decimal(10, 2)
  addressSnapshot     Json
  deliveryInstruction String?
  deliveryType        String               @default("INSTANT")
  deliveryDate        String?
  deliverySlot        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id])
  coupon              Coupon?              @relation(fields: [couponId], references: [id])
  items               OrderItem[]
  history             OrderStatusHistory[]
  payment             Payment?
  couponUsage         CouponUsage?
  deliveryAssignments DeliveryAssignment[]
  deliveryProofs      DeliveryProof[]
  deliveryStatusLogs  DeliveryStatusLog[]
  codCollection       CodCollection?
  deliveryChatMessages DeliveryChatMessage[]
  fifoAllocations     OrderFifoAllocation[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  name      String
  sku       String
  unit      String
  image     String? @db.Text
  mrp       Decimal @db.Decimal(10, 2)
  price     Decimal @db.Decimal(10, 2)
  costPrice Decimal @default(0) @db.Decimal(10, 2)
  quantity  Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  fifoAllocations OrderFifoAllocation[]

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String        @unique
  method    PaymentMethod
  status    PaymentStatus
  amount    Decimal       @db.Decimal(10, 2)
  reference String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  order     Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Banner {
  id          String       @id @default(cuid())
  kicker      String?
  heading     String
  subtitle    String?
  image       String?      @db.Text
  ctaText     String?
  destination String?
  position    Int          @default(0)
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("banners")
}

model DeliveryArea {
  id                    String            @id @default(cuid())
  name                  String
  pincodes              Json
  radiusKm              Decimal?          @db.Decimal(6, 2)
  minimumOrder          Decimal           @db.Decimal(10, 2)
  deliveryFee           Decimal           @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal           @db.Decimal(10, 2)
  estimatedMinutes      Int
  isPaused              Boolean           @default(false)
  schedule              Json?
  status                EntityStatus      @default(ACTIVE)
  villages              DeliveryVillage[]

  @@map("delivery_areas")
}

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  userId       String
  orderId      String?
  issueType    String
  subject      String
  description  String          @db.Text
  status       TicketStatus    @default(OPEN)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  user         User            @relation(fields: [userId], references: [id])
  messages     TicketMessage[]

  @@index([userId, status])
  @@map("support_tickets")
}

model TicketMessage {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String?
  isAdmin   Boolean       @default(false)
  message   String        @db.Text
  createdAt DateTime      @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model StoreSetting {
  id                    Int      @id @default(1)
  storeName             String
  logo                  String?  @db.Text
  contactNumber         String
  email                 String
  address               String   @db.Text
  openingTime           String
  closingTime           String
  currency              String   @default("INR")
  minimumOrder          Decimal  @db.Decimal(10, 2)
  deliveryFee           Decimal  @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal  @db.Decimal(10, 2)
  estimatedDelivery     String
  notifications         Json
  policies              Json?
  autoHideOutOfStock    Boolean  @default(false)
  globalDeliveryRadius  Decimal? @db.Decimal(6, 2) @default(5.00)
  isOrderPaused         Boolean  @default(false)
  orderPauseMessage     String?  @db.Text
  holidays              Json?
  weekdayHours          Json?
  prepTimeMinutes       Int      @default(30)
  seasonalSchedules     Json?
  specialDaySchedules   Json?
  allowAfterHoursScheduledOrders Boolean @default(true)
  isSchedulingEnabled   Boolean  @default(true)
  advanceBookingDays    Int      @default(4)
  sameDayCutoffMinutes  Int      @default(60)
  allowCod              Boolean  @default(true)
  allowScheduled        Boolean  @default(true)
  emergencySettings     Json?
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}

model OtpVerification {
  id                  String    @id @default(cuid())
  identifier          String
  purpose             String    @default("signup")
  codeHash            String
  pendingName         String?
  pendingMobile       String?
  pendingPasswordHash String?
  expiresAt           DateTime
  attempts            Int       @default(0)
  consumedAt          DateTime?
  createdAt           DateTime  @default(now())

  @@index([identifier, createdAt])
  @@map("otp_verifications")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model SearchHistory {
  id        String   @id @default(cuid())
  userId    String
  query     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("search_history")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  role      String   @default("CUSTOMER")
  endpoint  String   @db.VarChar(500) @unique
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
  @@map("push_subscriptions")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String?
  role      String   @default("CUSTOMER")
  token     String   @unique @db.VarChar(500)
  platform  String   @default("WEB")
  userAgent String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([role])
  @@map("device_tokens")
}

model DeliveryVillage {
  id                    String        @id @default(cuid())
  areaId                String?
  name                  String
  pincode               String?
  overrideMode          String        @default("COMPLETE") // "COMPLETE" (Mode A) or "PARTIAL" (Mode B)
  deliveryFee           Decimal       @db.Decimal(10, 2)
  minimumOrder          Decimal       @db.Decimal(10, 2)
  freeDeliveryThreshold Decimal       @db.Decimal(10, 2)
  radiusKm              Decimal?      @db.Decimal(6, 2) @default(5.00)
  schedule              String?
  deliveryHours         Json?
  customSlots           Json?
  allowCod              Boolean       @default(true)
  allowScheduled        Boolean       @default(true)
  estimatedMinutes      Int           @default(30)
  maxCapacity           Int?
  emergencyRestrictions Json?
  seasonalRules         Json?
  isPaused              Boolean       @default(false)
  status                EntityStatus  @default(ACTIVE)
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  area                  DeliveryArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([areaId])
  @@map("delivery_villages")
}

model EmergencyLog {
  id            String    @id @default(cuid())
  action        String    // "ACTIVATE" | "DEACTIVATE" | "UPDATE" | "AUTO_EXPIRE"
  type          String    // "IMMEDIATE_ONLY" | "SCHEDULED_ONLY" | "ALL_ORDERS" | "SELECTED_AREAS" | "STORE_CLOSE"
  reason        String
  customReason  String?
  message       String?   @db.Text
  affectedAreas Json?
  startTime     DateTime?
  endTime       DateTime?
  adminId       String?
  adminName     String?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@map("emergency_logs")
}

model InventoryLog {
  id            String   @id @default(cuid())
  productId     String
  type          String
  previousStock Int
  newStock      Int
  quantityDiff  Int
  reason        String
  adminId       String?
  adminName     String?
  orderId       String?
  createdAt     DateTime @default(now())
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
  @@index([type])
  @@map("inventory_logs")
}

model DeliverySlot {
  id            String       @id @default(cuid())
  label         String
  startTime     String
  endTime       String
  maxOrders     Int          @default(20)
  cutoffMinutes Int          @default(60)
  daysOfWeek    Json?
  position      Int          @default(0)
  status        EntityStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("delivery_slots")
}

model MarketingCampaign {
  id        String       @id @default(cuid())
  name      String
  type      String
  title     String
  subtitle  String?
  badge     String?
  content   String?      @db.Text
  imageUrl  String?      @db.Text
  linkUrl   String?
  bgColor   String?
  textColor String?
  startsAt  DateTime
  expiresAt DateTime
  status    EntityStatus @default(ACTIVE)
  position  Int          @default(0)
  metadata  Json?
  viewCount Int          @default(0)
  clickCount Int         @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type, status])
  @@map("marketing_campaigns")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?
  userName     String?
  userRole     String?
  module       String
  action       String
  resourceId   String?
  resourceName String?
  details      Json?
  ipAddress    String?
  userAgent    String?  @db.Text
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([module, createdAt])
  @@index([userId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model DeliveryAssignment {
  id               String              @id @default(cuid())
  orderId          String
  deliveryPersonId String
  assignedById     String
  status           DeliveryStatus      @default(ASSIGNED)
  assignedAt       DateTime            @default(now())
  acceptedAt       DateTime?
  pickedUpAt       DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  failureReason    String?
  failureNotes     String?             @db.Text
  failureEvidence  String?             @db.Text
  isCurrent        Boolean             @default(true)
  reassignedToId   String?
  notes            String?             @db.Text
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPerson   User                @relation("AssignedDeliveries", fields: [deliveryPersonId], references: [id])
  assignedBy       User                @relation("AssignmentsCreated", fields: [assignedById], references: [id])
  proofs           DeliveryProof[]
  codCollection    CodCollection?
  statusLogs       DeliveryStatusLog[]

  @@index([orderId])
  @@index([deliveryPersonId, status])
  @@index([isCurrent])
  @@map("delivery_assignments")
}

model DeliveryProof {
  id                 String              @id @default(cuid())
  assignmentId       String
  orderId            String
  deliveryPersonId   String
  cloudinaryPublicId String              @db.VarChar(500)
  cloudinaryUrl      String              @db.Text
  cloudinaryFolder   String?             @db.VarChar(255)
  verificationStatus String              @default("PENDING") // "PENDING" | "VERIFIED" | "FLAGGED" | "INVESTIGATING"
  verifiedById       String?
  verifiedAt         DateTime?
  verificationNotes  String?             @db.Text
  recipientName      String?
  recipientPhone     String?
  customerOtp        String?
  notes              String?             @db.Text
  createdAt          DateTime            @default(now())

  assignment         DeliveryAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPerson     User                @relation(fields: [deliveryPersonId], references: [id])
  verifiedBy         User?               @relation("VerifiedProofs", fields: [verifiedById], references: [id])

  @@index([orderId])
  @@index([deliveryPersonId])
  @@index([verificationStatus])
  @@map("delivery_proofs")
}

model DeliveryStatusLog {
  id             String              @id @default(cuid())
  assignmentId   String
  orderId        String
  staffId        String
  previousStatus String?
  newStatus      String
  metadata       Json?
  createdAt      DateTime            @default(now())

  assignment     DeliveryAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  order          Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  staff          User                @relation(fields: [staffId], references: [id])

  @@index([assignmentId])
  @@index([orderId])
  @@map("delivery_status_logs")
}

model CodCollection {
  id               String              @id @default(cuid())
  assignmentId     String              @unique
  orderId          String              @unique
  deliveryPersonId String
  expectedAmount   Decimal             @db.Decimal(10, 2)
  collectedAmount  Decimal             @db.Decimal(10, 2)
  settlementStatus String              @default("PENDING") // "PENDING" | "SETTLED" | "DISCREPANCY"
  settlementId     String?
  discrepancyNote  String?             @db.Text
  collectedAt      DateTime            @default(now())
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  assignment       DeliveryAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPerson   User                @relation(fields: [deliveryPersonId], references: [id])
  settlement       CodSettlement?      @relation(fields: [settlementId], references: [id])

  @@index([deliveryPersonId, settlementStatus])
  @@map("cod_collections")
}

model CodSettlement {
  id                  String          @id @default(cuid())
  settlementNumber    String          @unique
  deliveryPersonId    String
  settledById         String
  totalOrders         Int
  totalExpectedAmount Decimal         @db.Decimal(10, 2)
  totalCollectedAmount Decimal        @db.Decimal(10, 2)
  totalSettledAmount  Decimal         @db.Decimal(10, 2)
  discrepancyAmount   Decimal         @default(0.00) @db.Decimal(10, 2)
  notes               String?         @db.Text
  settledAt           DateTime        @default(now())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  deliveryPerson      User            @relation("SettledCollections", fields: [deliveryPersonId], references: [id])
  settledBy           User            @relation("AdminSettlements", fields: [settledById], references: [id])
  collections         CodCollection[]

  @@index([deliveryPersonId])
  @@index([settledById])
  @@map("cod_settlements")
}

model HomepageRankingConfig {
  id          String    @id
  bestSellers Json
  topPicks    Json
  version     Int       @default(1)
  publishedAt DateTime?
  publishedBy String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("homepage_ranking_configs")
}

model HomepageRankingHistory {
  id          String   @id @default(cuid())
  version     Int
  bestSellers Json
  topPicks    Json
  publishedBy String?
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([version])
  @@index([createdAt])
  @@map("homepage_ranking_history")
}

model DeliveryChatMessage {
  id           String             @id @default(cuid())
  orderId      String
  assignmentId String?
  senderId     String
  senderRole   String             // "CUSTOMER" | "DELIVERY_PERSON"
  senderName   String
  message      String             @db.Text
  isRead       Boolean            @default(false)
  readAt       DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  order        Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender       User               @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([senderId])
  @@map("delivery_chat_messages")
}

model Supplier {
  id            String            @id @default(cuid())
  code          String            @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?           @db.Text
  notes         String?           @db.Text
  status        EntityStatus      @default(ACTIVE)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  purchases     Purchase[]
  payments      SupplierPayment[]
  fifoBatches   FifoCostBatch[]

  @@index([status])
  @@index([name])
  @@map("suppliers")
}

model Purchase {
  id                String            @id @default(cuid())
  purchaseNumber    String            @unique
  supplierId        String
  invoiceNumber     String?
  purchaseDate      DateTime
  status            String            @default("DRAFT") // "DRAFT" | "RECEIVED" | "CANCELLED"
  subtotal          Decimal           @db.Decimal(10, 2)
  taxAmount         Decimal           @default(0.00) @db.Decimal(10, 2)
  freightLandedCost Decimal           @default(0.00) @db.Decimal(10, 2)
  discountAmount    Decimal           @default(0.00) @db.Decimal(10, 2)
  totalAmount       Decimal           @db.Decimal(10, 2)
  paymentStatus     String            @default("UNPAID") // "UNPAID" | "PARTIAL" | "PAID"
  paidAmount        Decimal           @default(0.00) @db.Decimal(10, 2)
  notes             String?           @db.Text
  receivedAt        DateTime?
  receivedById      String?
  receivedByName    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  supplier          Supplier          @relation(fields: [supplierId], references: [id])
  receivedBy        User?             @relation("PurchasesReceived", fields: [receivedById], references: [id], onDelete: SetNull)
  items             PurchaseItem[]
  payments          SupplierPayment[]
  fifoBatches       FifoCostBatch[]

  @@index([supplierId, status])
  @@index([purchaseDate])
  @@index([paymentStatus])
  @@map("purchases")
}

model PurchaseItem {
  id                String        @id @default(cuid())
  purchaseId        String
  productId         String
  productName       String
  sku               String
  unit              String
  quantity          Int
  unitCost          Decimal       @db.Decimal(10, 2)
  allocatedFreight  Decimal       @default(0.00) @db.Decimal(10, 2)
  effectiveUnitCost Decimal       @db.Decimal(10, 2)
  subtotal          Decimal       @db.Decimal(10, 2)
  batchNumber       String?
  expiryDate        DateTime?
  createdAt         DateTime      @default(now())

  purchase          Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product           Product       @relation(fields: [productId], references: [id])
  fifoBatches       FifoCostBatch[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model SupplierPayment {
  id            String        @id @default(cuid())
  paymentNumber String        @unique
  supplierId    String
  purchaseId    String?
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod String        @default("CASH") // "CASH" | "BANK_TRANSFER" | "UPI" | "CHEQUE" | "OTHER"
  reference     String?
  paymentDate   DateTime
  notes         String?       @db.Text
  createdById   String?
  createdByName String?
  createdAt     DateTime      @default(now())

  supplier      Supplier      @relation(fields: [supplierId], references: [id])
  purchase      Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  createdBy     User?         @relation("SupplierPaymentsCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([supplierId, paymentDate])
  @@index([purchaseId])
  @@map("supplier_payments")
}

model FifoCostBatch {
  id                  String                    @id @default(cuid())
  batchNumber         String?
  productId           String
  supplierId          String?
  purchaseId          String?
  purchaseItemId      String?
  receivedDate        DateTime
  quantityReceived    Int
  quantityRemaining   Int
  originalUnitCost    Decimal                   @db.Decimal(10, 2)
  landedCostPerUnit   Decimal                   @default(0.00) @db.Decimal(10, 2)
  effectiveUnitCost   Decimal                   @db.Decimal(10, 2)
  isOpeningStock      Boolean                   @default(false)
  isVerified          Boolean                   @default(true)
  notes               String?                   @db.Text
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  product             Product                   @relation(fields: [productId], references: [id])
  supplier            Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchase            Purchase?                 @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseItem        PurchaseItem?             @relation(fields: [purchaseItemId], references: [id], onDelete: SetNull)
  allocations         OrderFifoAllocation[]
  wastageAllocations  StockWastageBatchAllocation[]

  @@index([productId, quantityRemaining])
  @@index([receivedDate, createdAt])
  @@index([purchaseId])
  @@map("fifo_cost_batches")
}

model OrderFifoAllocation {
  id          String         @id @default(cuid())
  orderId     String
  orderItemId String
  productId   String
  batchId     String?
  quantity    Int
  unitCost    Decimal        @db.Decimal(10, 2)
  totalCost   Decimal        @db.Decimal(10, 2)
  sellingPrice Decimal       @db.Decimal(10, 2)
  isCostKnown Boolean        @default(true)
  status      String         @default("COMMITTED") // "COMMITTED" | "REVERSED"
  reversedAt  DateTime?
  createdAt   DateTime       @default(now())

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem   OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  batch       FifoCostBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  product     Product        @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([orderItemId])
  @@index([productId])
  @@index([batchId])
  @@index([status, createdAt])
  @@map("order_fifo_allocations")
}

model Expense {
  id            String        @id @default(cuid())
  expenseNumber String        @unique
  expenseDate   DateTime
  category      String        // "DELIVERY_FUEL" | "PACKAGING" | "TRANSPORT_FREIGHT" | "RENT" | "UTILITIES" | "MAINTENANCE" | "MARKETING" | "WASTAGE_EXPIRY" | "OTHER"
  description   String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod String        @default("CASH") // "CASH" | "BANK_TRANSFER" | "UPI" | "COD_SETTLEMENT_DEDUCTION" | "OTHER"
  status        String        @default("PAID") // "PAID" | "PENDING"
  payee         String?
  reference     String?
  notes         String?       @db.Text
  receiptUrl    String?       @db.Text
  createdById   String?
  createdByName String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdBy     User?         @relation("ExpensesCreated", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([category, expenseDate])
  @@index([expenseDate])
  @@map("expenses")
}

model StockWastageBatchAllocation {
  id            String        @id @default(cuid())
  batchId       String
  productId     String
  quantity      Int
  unitCost      Decimal       @db.Decimal(10, 2)
  totalCostLoss Decimal       @db.Decimal(10, 2)
  reason        String        // "EXPIRED" | "DAMAGED" | "SPOILED" | "INTERNAL_LOSS"
  notes         String?       @db.Text
  recordedById  String?
  recordedByName String?
  createdAt     DateTime      @default(now())

  batch         FifoCostBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([productId, createdAt])
  @@map("stock_wastage_batch_allocations")
}


